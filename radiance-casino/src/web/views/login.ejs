<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Penthouse | Admin Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-light">
    <div class="login-container">
        <div class="login-card-wrapper">
            <div class="text-center mb-4">
                <img src="/img/logo.png" alt="Penthouse" height="50" class="mb-4 rounded">
                <h1 class="fw-bold text-dark mb-2" style="letter-spacing: -2px; font-size: 2.5rem;">Welcome back</h1>
                <p class="text-secondary">Enter your credentials to access the portal</p>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form action="/login" method="POST">
                        <div class="mb-4">
                            <label class="sidebar-section-label m-0 mb-2 d-block">Username</label>
                            <input type="text" name="username" class="form-control py-3 bg-light border-0"
                                placeholder="admin" required>
                        </div>
                        <div class="mb-4">
                            <label class="sidebar-section-label m-0 mb-2 d-block">Password</label>
                            <input type="password" name="password" class="form-control py-3 bg-light border-0"
                                placeholder="••••••••" required>
                        </div>
                        <button type="submit" class="btn btn-login w-100 py-3 mt-2">
                            Sign In
                        </button>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="/" class="text-secondary text-decoration-none small hover-primary">
                    <i class="fa-solid fa-arrow-left me-2"></i> Back to Homepage
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>