<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Penthouse | Configuration</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>

<body class="bg-light">
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <a href="/" class="sidebar-brand text-decoration-none">
                <img src="/img/logo.png" alt="Penthouse" class="rounded">
            </a>

            <div class="sidebar-section-label">Homepage</div>
            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="/dashboard" class="nav-link">
                        <i class="fa-solid fa-house"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-section-label">Apps</div>
            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="#" class="nav-link active">
                        <i class="fa-solid fa-gears"></i>
                        <span>Casino Settings</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <div class="user-profile mb-3">
                    <img src="https://cdn.discordapp.com/embed/avatars/0.png" class="user-avatar" alt="User">
                    <div class="user-info text-start">
                        <div class="fw-bold text-dark small">
                            <%= user.username %>
                        </div>
                        <div class="text-secondary" style="font-size: 0.7rem;">Administrator</div>
                    </div>
                </div>
                <a href="/logout" class="nav-link text-danger p-0">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span>Logout</span>
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">


            <div class="d-flex align-items-center justify-content-between mb-5">
                <div class="d-flex align-items-center gap-3">
                    <a href="/dashboard" class="btn btn-outline p-0 d-flex align-items-center justify-content-center"
                        style="width: 40px; height: 40px;">
                        <i class="fa-solid fa-arrow-left"></i>
                    </a>
                    <div>
                        <h2 class="fw-bold mb-0 text-dark">
                            <%= guild.name %>
                        </h2>
                        <p class="text-secondary small mb-0">Management Portal / Configuration</p>
                    </div>
                </div>
                <button id="saveBtn" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk me-2 small"></i> Save Changes
                </button>
            </div>

            <div class="row g-4">
                <!-- Left Column: Access Controls -->
                <div class="col-lg-4">
                    <div class="card mb-4">
                        <div class="card-title text-dark">
                            Access Control
                            <i class="fa-solid fa-shield-halved text-primary opacity-50"></i>
                        </div>
                        <div class="mb-4">
                            <label class="sidebar-section-label m-0 mb-2 d-block">Required Role</label>
                            <select id="gameRoleId" class="form-control form-select bg-light border-0">
                                <option value="">None (Everyone can play)</option>
                                <% roles.forEach(role=> { %>
                                    <option value="<%= role.id %>" <%=settings.gameRoleId===role.id ? 'selected' : '' %>
                                        ><%= role.name %>
                                    </option>
                                    <% }); %>
                            </select>
                            <p class="text-secondary small mt-2">Restrict games to specific roles.</p>
                        </div>
                        <div class="mb-0">
                            <label class="sidebar-section-label m-0 mb-2 d-block">Game Category</label>
                            <select id="gameCategoryId" class="form-control form-select bg-light border-0">
                                <option value="">None (All channels allowed)</option>
                                <% categories.forEach(category=> { %>
                                    <option value="<%= category.id %>" <%=settings.gameCategoryId===category.id
                                        ? 'selected' : '' %>><%= category.name %>
                                    </option>
                                    <% }); %>
                            </select>
                            <p class="text-secondary small mt-2">Restrict games to specific categories.</p>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-title text-dark">
                            Staff Controls
                            <i class="fa-solid fa-user-shield text-primary opacity-50"></i>
                        </div>
                        <div class="mb-0">
                            <label class="sidebar-section-label m-0 mb-2 d-block">Admin Role</label>
                            <select id="adminRoleId" class="form-control form-select bg-light border-0">
                                <option value="">Administrator Only</option>
                                <% roles.forEach(role=> { %>
                                    <option value="<%= role.id %>" <%=settings.adminRoleId===role.id ? 'selected' : '' %>
                                        ><%= role.name %>
                                    </option>
                                    <% }); %>
                            </select>
                            <p class="text-secondary small mt-2">Role required to use administrative commands like <code>/addmoney</code>.</p>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-title text-dark">
                            Auto-Leaderboard
                            <i class="fa-solid fa-trophy text-primary opacity-50"></i>
                        </div>
                        <div class="mb-0">
                            <label class="sidebar-section-label m-0 mb-2 d-block">Leaderboard Channel</label>
                            <select id="leaderboardChannelId" class="form-control form-select bg-light border-0">
                                <option value="">None (Disabled)</option>
                                <% channels.forEach(channel=> { %>
                                    <option value="<%= channel.id %>" <%=settings.leaderboardChannelId===channel.id
                                        ? 'selected' : '' %>><%= channel.name %>
                                    </option>
                                    <% }); %>
                            </select>
                            <p class="text-secondary small mt-2">A message will be created and auto-updated with top players in this channel.</p>
                        </div>
                    </div>

                    <!-- Game Rooms -->
                    <div class="card mb-4">
                        <div class="card-title text-dark">
                            Game-Specific Rooms
                            <i class="fa-solid fa-gamepad text-primary opacity-50"></i>
                        </div>
                        <% ['crash', 'hilo', 'mines', 'tower' ].forEach(game=> { %>
                            <div class="mb-3">
                                <label class="sidebar-section-label m-0 mb-1 d-block text-capitalize">
                                    <%= game %> Room
                                </label>
                                <select id="room-<%= game %>" class="form-control form-select bg-light border-0 game-room-select">
                                    <option value="">No specific room (Category Default)</option>
                                    <% channels.forEach(channel=> { %>
                                        <option value="<%= channel.id %>" <%=settings.gameRooms &&
                                            settings.gameRooms[game]===channel.id ? 'selected' : '' %>><%= channel.name %>
                                        </option>
                                        <% }); %>
                                </select>
                            </div>
                            <% }); %>
                                <p class="text-secondary small mt-2">Set specific channels for each game. Overrides Game
                                    Category if set.</p>
                    </div>

                    <div class="card">
                        <div class="card-title text-dark">
                            Server Profile
                            <i class="fa-solid fa-circle-info text-secondary opacity-50"></i>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <% if (guild.icon) { %>
                                <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png"
                                    class="user-avatar shadow-sm" style="width: 50px; height: 50px;" alt="">
                                <% } %>
                                    <div>
                                        <div class="fw-bold text-dark">
                                            <%= guild.name %>
                                        </div>
                                        <div class="text-secondary small">ID: <%= guild.id %>
                                        </div>
                                    </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Ranks -->
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-title text-dark">
                            <span>Ranking System</span>
                            <span class="badge badge-success small rounded-pill">
                                <%= settings.ranks.length %> Active Tiers
                            </span>
                        </div>
                        <div class="table-responsive">
                            <table class="table align-middle text-light">
                                <thead>
                                    <tr>
                                        <th class="sidebar-section-label border-0 ps-0 text-secondary">Rank Name</th>
                                        <th class="sidebar-section-label border-0 text-secondary">Threshold ($)</th>
                                        <th class="sidebar-section-label border-0 text-secondary">Max Bet ($)</th>
                                        <th class="sidebar-section-label border-0 text-secondary">Assigned Role</th>
                                    </tr>
                                </thead>
                                <tbody id="ranksList">
                                    <% settings.ranks.forEach((rank, index)=> { %>
                                        <tr data-index="<%= index %>" class="border-bottom border-secondary">
                                            <td class="fw-bold text-light ps-0 py-3">
                                                <%= rank.name %>
                                            </td>
                                            <td class="py-3">
                                                <div class="input-group rounded"
                                                    style="max-width: 150px; padding: 0.25rem 0.5rem; background-color: var(--aurora-surface); border: 1px solid var(--aurora-border);">
                                                    <span
                                                        class="input-group-text bg-transparent border-0 text-secondary ps-0">$</span>
                                                    <input type="number"
                                                        class="form-control bg-transparent border-0 rounded-0 p-0 threshold-input"
                                                        value="<%= rank.threshold %>">
                                                </div>
                                            </td>
                                            <td class="py-3">
                                                <div class="input-group rounded"
                                                    style="max-width: 150px; padding: 0.25rem 0.5rem; background-color: var(--aurora-surface); border: 1px solid var(--aurora-border);">
                                                    <span
                                                        class="input-group-text bg-transparent border-0 text-secondary ps-0">$</span>
                                                    <input type="number"
                                                        class="form-control bg-transparent border-0 rounded-0 p-0 maxbet-input"
                                                        value="<%= rank.maxBet || 0 %>">
                                                </div>
                                            </td>
                                            <td class="py-3">
                                                <select
                                                    class="form-control form-select-sm rank-role-select bg-transparent border-0 rounded p-2"
                                                    style="background-color: var(--aurora-surface); border: 1px solid var(--aurora-border);">
                                                    <option value="">No Role</option>
                                                    <% roles.forEach(role=> { %>
                                                        <option value="<%= role.id %>" <%=rank.roleId===role.id
                                                            ? 'selected' : '' %>><%= role.name %>
                                                        </option>
                                                        <% }); %>
                                                </select>
                                            </td>
                                        </tr>
                                        <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <div id="toast" class="position-fixed bottom-0 end-0 p-4" style="z-index: 9999; display: none;">
        <div class="alert alert-success bg-success text-white fw-bold shadow-lg border-0 mb-0 px-4 py-3 rounded-3">
            <i class="fa-solid fa-check-circle me-2"></i> Settings Saved Successfully!
        </div>
    </div>

    <script src="/js/script.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>