# ---------------------------------------------------------------------------
# Copy to .env for local development, or paste these into Render's
# Environment tab. Never commit real values.
# ---------------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=production
# Render injects PORT automatically; the code falls back to 3000 locally.
# PORT=3000
# Public URL of the Render service (used for Stripe redirects)
APP_URL=https://your-service-name.onrender.com

# --- Discord bot (required) ---
DISCORD_BOT_TOKEN=your_discord_bot_token
# DISCORD_TOKEN is accepted as an alias by bot.ts
DISCORD_CLIENT_ID=your_discord_application_id
# Only needed if you use Discord OAuth2 flows
DISCORD_CLIENT_SECRET=your_discord_client_secret

# --- Supabase (required; same project, three values) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- AI providers (required for AI features) ---
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# --- Billing (optional) ---
STRIPE_BUSINESS_PAYMENT_LINK=
STRIPE_ENTERPRISE_PAYMENT_LINK=
STRIPE_CHECKOUT_BASE_URL=
STRIPE_PORTAL_URL=
STRIPE_WEBHOOK_SECRET=
BILLING_BUSINESS_PRICE_MONTHLY=29
BILLING_ENTERPRISE_PRICE_MONTHLY=99

# --- Security (optional) ---
VIRUSTOTAL_API_KEY=
